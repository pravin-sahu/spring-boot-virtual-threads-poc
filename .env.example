# ─────────────────────────────────────────────────────────────────
# .env.example
#
# Copy this file to .env and fill in values for local development.
# .env is gitignored — NEVER commit .env with real credentials.
#
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# ── Spring ───────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local
APP_PORT=8001

# ── DATABASE (local Docker) ─────────────────────────────────────
# These are the values the app uses to connect to Postgres
# ─────────────────────────────────────────────────────────────────
DATABASE_NAME=mb-spring-boilerplate
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme_local_only
